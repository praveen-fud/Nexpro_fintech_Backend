# ── Local development defaults ──────────────────────────────────────────────
# Copy this file to .env and adjust values.
# Railway: set these as Environment Variables in the Railway dashboard instead
#          of committing a .env file.

APP_NAME=Nexpro Fintech API
ENVIRONMENT=development          # Change to "production" on Railway

# Database
# Local dev (zero-install SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Railway PostgreSQL (add the Railway Postgres plugin, it sets DATABASE_URL
# automatically — or paste your connection string here):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/nexpro

# JWT — MUST be changed to a long random string before deploying.
# Generate one with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=insecure-dev-secret-change-me-before-production-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
IDLE_TIMEOUT_MINUTES=15
SESSION_MAX_HOURS=12

# CORS — comma-separated list of allowed frontend origins.
# Railway: set to your Railway frontend URL, e.g.:
# CORS_ORIGINS=["https://nexpro-frontend.up.railway.app"]
CORS_ORIGINS=["http://localhost:5173"]

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Add Money: where customers send UPI / bank-transfer payments ────────────
# REQUIRED in production (the API returns 503 if missing). Development shows
# clearly-marked demo values when these are blank.
PAYEE_UPI_ID=
PAYEE_UPI_NAME=
PAYEE_BANK_ACCOUNT_NAME=
PAYEE_BANK_NAME=
PAYEE_BANK_ACCOUNT_NUMBER=
PAYEE_BANK_IFSC=

# ── Card payments (Razorpay) ────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use rzp_test_* keys until live.
# The secret and webhook secret stay on the server only — never commit them.
# Webhook URL to register: https://<backend-domain>/api/v1/funding-requests/card/webhook
# (event: payment.captured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
