# ── Local development defaults ──────────────────────────────────────────────
# Copy this file to .env and adjust values.
# Railway: set these as Environment Variables in the Railway dashboard instead
#          of committing a .env file.
#
# Settings are validated at startup (app/core/config.py). In production the
# app REFUSES TO BOOT on an unsafe combination rather than serving traffic
# with it — a missing/placeholder JWT secret, wildcard CORS, SQLite, or a
# wildcard trusted-host list will all stop the deploy with a clear message.

APP_NAME=Nexpro Paytech API
ENVIRONMENT=development          # Change to "production" on Railway

# Database
# Local dev (zero-install SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Railway PostgreSQL (add the Railway Postgres plugin, it sets DATABASE_URL
# automatically — or paste your connection string here):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/nexpro

# JWT — REQUIRED in production, with no fallback. Leave blank in development
# and a random secret is generated into a gitignored .dev-jwt-secret file so
# dev sessions survive restarts without a secret ever entering the repo.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
IDLE_TIMEOUT_MINUTES=15
SESSION_MAX_HOURS=12

# Refresh-cookie policy. Use "none" ONLY when the SPA is served from a
# different site than the API (it forces Secure, so it needs https).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.nexpro.example

# CORS — accepts a JSON list or a plain comma-separated list.
# "*" is rejected in production, as are plaintext http:// origins.
CORS_ORIGINS=http://localhost:5173

# Host header allowlist. "*" is fine in dev, rejected in production — set it
# to this service's own hostname(s).
TRUSTED_HOSTS=*
# TRUSTED_HOSTS=nexpro-api.up.railway.app

# Interactive docs. Unset = on outside production, off in production.
# Set to true only if you deliberately want a public schema dump.
# ENABLE_DOCS=false

# /auth/verify-otp is dormant and does NOT validate the code it is sent.
# Leave this off until a real OTP provider is wired up.
ENABLE_OTP_ENDPOINT=false

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_REQUEST_BODY_MB=10

# ── Rate limiting ───────────────────────────────────────────────────────────
# Windows are "<requests>/<seconds>", keyed on client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/60
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_SIGNUP=5/3600
RATE_LIMIT_REFRESH=60/300
RATE_LIMIT_WRITE=30/60
RATE_LIMIT_UPLOAD=10/600
# Per-account lockout, independent of the per-IP budget, so a password spray
# spread over many IPs still trips it.
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SECONDS=900
# Proxy hops in front of the app (Railway and most PaaS = 1). Only the
# right-most hops of X-Forwarded-For are trustworthy; set this to 0 if the
# app is exposed directly, or per-IP limits can be bypassed with a forged
# header.
TRUSTED_PROXY_HOPS=1

# ── Add Money: where customers send UPI / bank-transfer payments ────────────
# REQUIRED in production (the API returns 503 if missing). Development shows
# clearly-marked demo values when these are blank.
PAYEE_UPI_ID=
PAYEE_UPI_NAME=
PAYEE_BANK_ACCOUNT_NAME=
PAYEE_BANK_NAME=
PAYEE_BANK_ACCOUNT_NUMBER=
PAYEE_BANK_IFSC=

# ── Card payments (Razorpay) ────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use rzp_test_* keys until live.
# The secret and webhook secret stay on the server only — never commit them.
# Webhook URL to register: https://<backend-domain>/api/v1/funding-requests/card/webhook
# (event: payment.captured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
