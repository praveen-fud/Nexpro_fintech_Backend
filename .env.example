# Copy to .env and adjust as needed. All of these have safe local-dev
# defaults in app/core/config.py, so the app runs without a .env file too.

APP_NAME=Nexpro Fintech API
ENVIRONMENT=development

# Zero-install default. For a production-like setup via Docker Compose, use:
# DATABASE_URL=postgresql+asyncpg://nexpro:nexpro@localhost:5432/nexpro
DATABASE_URL=sqlite+aiosqlite:///./dev.db

JWT_SECRET=insecure-dev-secret-change-me-before-production-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
